+fn valid_text_span(text: &str, span: Option<TextSpan>) -> Option<std::ops::Range<usize>> {
+    let span = span?;
+    let start = utf16_index_to_byte_index(text, span.start);
+    let end = utf16_index_to_byte_index(text, span.end);
+
+    (start < end).then_some(start..end)
+}
+
+fn utf16_index_to_byte_index(text: &str, index: usize) -> usize {
+    let mut utf16_offset = 0;
+
+    for (byte_offset, character) in text.char_indices() {
+        if utf16_offset >= index {
+            return byte_offset;
+        }
+
+        let next = utf16_offset + character.len_utf16();
+        if index < next {
+            return byte_offset;
+        }
+        utf16_offset = next;
+    }
+
+    text.len()
+}
+
+fn preedit_selection(
+    text: &str,
+    selection: TextSpan,
+    compose_region: &std::ops::Range<usize>,
+) -> Option<(usize, usize)> {
+    let start = utf16_index_to_byte_index(text, selection.start);
+    let end = utf16_index_to_byte_index(text, selection.end);
+
+    if start < compose_region.start || end > compose_region.end {
+        return None;
+    }
+
+    Some((
+        text[compose_region.start..start].chars().count(),
+        text[compose_region.start..end].chars().count(),
+    ))
+}
