+static ACTIVITY_LIFECYCLE_LISTENER: std::sync::Mutex<Option<fn(bool)>> =
+    std::sync::Mutex::new(None);
+
+/// Installs a non-blocking observer for Android Activity resume/pause changes.
+///
+/// The observer runs on the native event-loop thread. It must not wait for the
+/// Java UI thread, which may be waiting for the current lifecycle callback.
+pub fn set_activity_lifecycle_listener(listener: Option<fn(bool)>) {
+    *ACTIVITY_LIFECYCLE_LISTENER.lock().unwrap() = listener;
+}
+
+pub(crate) fn notify_activity_lifecycle(resumed: bool) {
+    let listener = *ACTIVITY_LIFECYCLE_LISTENER.lock().unwrap();
+    if let Some(listener) = listener {
+        listener(resumed);
+    }
+}

